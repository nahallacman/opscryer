# OpsCryer Public Release — Local Environment & OpenAI API Credit Configuration
# Copy this file to `.env` (which is gitignored) and supply your OpenAI API key or Ollama URL.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_BUDGET_USD=5.00
OPSCRYER_USE_LIVE_OPENAI=1
OPSCRYER_OLLAMA_URL=
