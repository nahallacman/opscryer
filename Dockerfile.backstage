# Backstage 2.0 container with the OpsCryer frontend plugin embedded.
#
# Build context: Backstage 2.0 app repo root.
# The OpsCryer plugin source (plugins/opscryer/) is consumed from the OpsCryer repo.
#
# Build:
#   docker build -f Dockerfile.backstage -t backstage-opscryer:latest .
FROM node:22-bookworm-slim

WORKDIR /backstage

# Install yarn (corepack) for Backstage tooling
RUN corepack enable

# Copy the Backstage 2.0 repo
COPY . .

# Install dependencies and build all packages
RUN yarn install --frozen-lockfile && \
    yarn build:all

# Expose Backstage frontend (3000) and backend (7007)
EXPOSE 3000 7007

# Start the Backstage app (runs backend + frontend via repo start script)
CMD ["yarn", "start"]
