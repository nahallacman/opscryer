# Never commit secret keys, .env files, or local runtime caches
.env
.env.*
!.env.example
*.key
*.pem
__pycache__/
*.py[cod]
.venv/
*.log
*.pid
dist/
scratch/

# Live/external Knowledge Graph files must never be committed inside the tool repo
*company*graph*.json
*enterprise*graph*.json
curated-graph.json
knowledge-graph.json
external-graph*.json
